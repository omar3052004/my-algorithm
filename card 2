#include <iostream>
#include <vector>

using namespace std;

int main() {

    int n, q;
    cin >> n >> q;

    vector<int> first_pos(51, 0);
    for (int i = 1; i <= n; i++) {
        int color;
        cin >> color;
        if (first_pos[color] == 0) {
            first_pos[color] = i;
        }
    }

    for (int i = 0; i < q; i++) {
        int target;
        cin >> target;

        int current_p = first_pos[target];
        cout << current_p << (i == q - 1 ? "" : " ");

        for (int j = 1; j <= 50; j++) {
            if (first_pos[j] != 0 && first_pos[j] < current_p) {
                first_pos[j]++;
            }
        }
        first_pos[target] = 1;
    }

    cout << endl;
    return 0;
}
